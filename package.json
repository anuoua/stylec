{
  "name": "stylec",
  "version": "0.0.1",
  "private": true,
  "description": "Compile-time CSS-in-JS: .stylec.css -> .stylec.ts",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@stylec/runtime": "workspace:*",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuoua/stylec.git"
  },
  "homepage": "https://github.com/anuoua/stylec#readme",
  "bugs": {
    "url": "https://github.com/anuoua/stylec/issues"
  }
}
